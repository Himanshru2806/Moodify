MOODIFY_APP_NAME=Moodify
MOODIFY_API_PREFIX=/api/v1
MOODIFY_CORS_ORIGINS=["http://localhost:5173"]
MOODIFY_MAX_IMAGE_BYTES=5242880

# Optional: set a full URL only when the frontend should bypass the Vite development proxy.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# YouTube Data API / OAuth (backend only; add these to backend/.env, never to VITE_* variables)
# Enable YouTube Data API v3 in the Google Cloud project used for this key.
MOODIFY_YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
MOODIFY_YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
MOODIFY_YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
MOODIFY_YOUTUBE_API_KEY=your-youtube-data-api-key
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOODIFY_YOUTUBE_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
